# Copy to .env and adjust. Every variable is optional; the defaults below are
# what the services use when nothing is set.

# -- orchestrator ------------------------------------------------------------
CMS_ENVIRONMENT=local            # local | ci | staging | production
CMS_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
CMS_JSON_LOGS=false

# -- local inference ---------------------------------------------------------
# On Linux with Ollama installed on the host, keep host.docker.internal; the
# compose file maps it to the host gateway.
CMS_OLLAMA_BASE_URL=http://host.docker.internal:11434
CMS_AUDIT_MODEL=qwen2.5-coder:7b
CMS_REFACTOR_MODEL=qwen2.5-coder:14b
CMS_REASONING_MODEL=deepseek-r1:8b
CMS_LLM_TEMPERATURE=0.1
CMS_LLM_NUM_CTX=8192
CMS_OLLAMA_TIMEOUT_S=180

# Refuse any non-local inference endpoint. Leave this on: it is the technical
# enforcement behind "your code never leaves the machine".
CMS_OFFLINE_ONLY=true

# -- telemetry ---------------------------------------------------------------
CMS_TELEMETRY_ENABLED=true
CMS_TELEMETRY_BASE_URL=http://telemetry-api:8080

# -- database ----------------------------------------------------------------
POSTGRES_PASSWORD=cms
